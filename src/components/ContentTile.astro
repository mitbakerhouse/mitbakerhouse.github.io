---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = "" } = Astro.props;
---

<article class={`glass rounded-lg p-6 md:p-8 mb-6 intersect:animate-fadeUp opacity-0 ${className}`}>
  <h2 class="h3 mb-4 border-none">{title}</h2>
  <div class="flex flex-col gap-6 md:flex-row md:items-start">
    <slot name="media" />
    <div class="content min-w-0 flex-1">
      <slot />
    </div>
  </div>
</article>
