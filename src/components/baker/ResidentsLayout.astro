---
import BaseLayout from "@components/base/BaseLayout.astro";
import ResidentsSidebar from "@components/baker/ResidentsSidebar.astro";
import { pageBackgrounds } from "@lib/pageBackgrounds";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Residents", description } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  pageBackground={pageBackgrounds.residents}
>
  <section class="container py-6">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start">
      <aside class="w-full lg:w-1/4 shrink-0">
        <ResidentsSidebar />
      </aside>
      <div class="min-w-0 flex-1">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
