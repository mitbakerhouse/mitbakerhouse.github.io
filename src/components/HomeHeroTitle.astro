---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  titleImage?: ImageMetadata;
  titleImageAlt?: string;
}

const { titleImage, titleImageAlt } = Astro.props;

const textTitleLabel =
  "Find out what turns Baker House into a Baker Home";
---

{
  titleImage ? (
    <h1 class="home-hero-title home-hero-title--image mb-0">
      <Image
        class="home-hero-title__image"
        src={titleImage}
        alt={titleImageAlt ?? textTitleLabel}
        loading="eager"
      />
    </h1>
  ) : (
    <h1
      class="home-hero-title mb-0"
      aria-label={textTitleLabel}
    >
      <span class="home-hero-title__group">
        <span class="home-hero-title__line home-hero-title__line--small"
          >Find out what turns</span
        >
        <span class="home-hero-title__line home-hero-title__line--large"
          >Baker House</span
        >
      </span>
      <span class="home-hero-title__group home-hero-title__group--offset">
        <span class="home-hero-title__line home-hero-title__line--small"
          >into a</span
        >
        <span class="home-hero-title__line home-hero-title__line--large"
          >Baker Home</span
        >
      </span>
    </h1>
  )
}

<style lang="scss">
  .home-hero-title {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.05;
    text-align: left;
  }

  .home-hero-title--image {
    display: block;
    width: min(75vw, 100%);
    max-width: 75vw;
    margin-inline: auto;
    text-align: center;
  }

  .home-hero-title__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    margin-inline: auto;
  }

  .home-hero-title__group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .home-hero-title__group--offset {
    margin-top: 0.2em;
    margin-left: -0.55em;
  }

  .home-hero-title__line--small {
    font-size: 0.42em;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  .home-hero-title__line--large {
    font-weight: 700;
  }
</style>
