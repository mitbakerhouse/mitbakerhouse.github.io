---
import StackedMarkdownLayout from "@layouts/StackedMarkdownLayout.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("docs", "residents/reservations");
if (!entry) {
  throw new Error("Reservations content missing");
}
const { title, description } = entry.data;
---

<StackedMarkdownLayout
  entry={entry}
  title={title}
  description={description}
  residents
/>
