---
import ContentTile from "@components/baker/ContentTile.astro";
import ResidentsLayout from "@components/baker/ResidentsLayout.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("docs", "residents/-index");
if (!entry) {
  throw new Error("Residents content missing");
}
const { description } = entry.data;
---

<ResidentsLayout description={description}>
  <ContentTile title="Guest List">
    <p>
      Each resident may put up to 4 students on their guest list.
      <br />
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSdP_oDWznfEFyiRa5XrOgDmX1eir5q3v_cCZXh3O_EP4iuCSg/viewform"
      >
        Go to Guest List Form
      </a>
    </p>
  </ContentTile>

  <ContentTile title="Baker Exec">
    <p>
      Baker Exec is the dorm government of Baker House, Baker Home. We plan
      community events, provide communication between students and the
      houseteam, and represent Baker to the larger MIT community.
    </p>
    <img
      src="/BakerExecPosterSP25_short.svg"
      alt="List of Baker Exec members and their photographs"
      class="mt-4 w-full max-w-[700px] rounded-lg"
      width="700"
      loading="lazy"
    />
  </ContentTile>

  <ContentTile title="RPMs">
    <p>
      The function of the Residential Peer Mentor (RPM) is to strengthen the
      support network for first-year students within Baker House. Peer Mentors
      are community-builders and serve as support for first-year students,
      helping answer questions, connect them to resources, and introduce them
      to the unique aspects of both Baker House and MIT. Baker House RPMs
      collaborate on programs focused on health and wellness, academic success,
      and the transition to MIT and learning about the campus, its resources,
      and the opportunities around Cambridge and Boston to make sure that the
      first-year experience is smooth, seamless, and full of opportunities to
      learn.
    </p>
    <img
      src="/images/houseteam/rpm_poster.jpg"
      alt="RPM list"
      class="mt-4 w-full max-w-[700px] rounded-lg"
      width="700"
      loading="lazy"
    />
  </ContentTile>
</ResidentsLayout>
