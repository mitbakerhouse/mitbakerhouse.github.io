---
import StackedMarkdownLayout from "@layouts/StackedMarkdownLayout.astro";
import EventPosterCarousel from "@components/EventPosterCarousel";
import { eventPosters } from "@lib/eventPosters";
import { getEntry } from "astro:content";

const entry = await getEntry("docs", "residents/events");
if (!entry) {
  throw new Error("Events content missing");
}
const { title, description } = entry.data;
---

<StackedMarkdownLayout
  entry={entry}
  title={title}
  description={description}
  residents
>
  <EventPosterCarousel slot="after" posters={eventPosters} client:load />
</StackedMarkdownLayout>
