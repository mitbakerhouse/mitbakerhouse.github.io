---
import StackedMarkdownLayout from "@layouts/StackedMarkdownLayout.astro";
import { getEntry } from "astro:content";

const entry = await getEntry("docs", "facilities");
if (!entry) {
  throw new Error("Facilities content missing");
}
const { title, description } = entry.data;
---

<StackedMarkdownLayout entry={entry} title={title} description={description} />
