---
import type { AuthorsEntry } from "@/types";
import BaseLayout from "@components/base/BaseLayout.astro";
import HouseteamTile from "@components/baker/HouseteamTile.astro";
import { getEntries } from "@lib/contentParser";
import { sortHouseteam } from "@lib/houseteamOrder";
import { pageBackgrounds } from "@lib/pageBackgrounds";
import { getIndex } from "@lib/contentParser";
import { render } from "astro:content";

const authorIndex = await getIndex("authors");
const { Content: Intro } = await render(authorIndex);
const entries = (await getEntries("authors")) as AuthorsEntry[];
const houseteam = sortHouseteam(entries);
---

<BaseLayout
  title={authorIndex.data.title}
  description={authorIndex.data.description}
  pageBackground={pageBackgrounds.houseteam}
>
  <section class="container py-6 max-w-4xl">
    <div class="glass rounded-lg p-4 mb-6 text-center intersect:animate-fadeDown opacity-0">
      <Intro />
    </div>
    {houseteam.map((entry) => <HouseteamTile entry={entry} />)}
  </section>
</BaseLayout>
