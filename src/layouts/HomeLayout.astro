---
import BaseLayout from "@layouts/BaseLayout.astro";
import { markdownify } from "@lib/textConverter";
import Button from "@components/common/Button.astro";
import HomeHeroTitle from "@components/HomeHeroTitle.astro";
import MarkdownBody from "@components/MarkdownBody.astro";
import type { HomeEntry } from "@/types";

interface Props {
  entry: HomeEntry;
}

const { entry } = Astro.props;
const { content, button, image, titleImage, titleImageAlt, title } =
  entry.data;
const hasMarkdownBody = Boolean(entry.body?.trim());
---

<BaseLayout pageBackground={image?.src}>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="text-center lg:col-9">
          <div class="glass rounded-lg px-8 py-10 intersect:animate-fadeUp opacity-0">
            <HomeHeroTitle
              titleImage={titleImage}
              titleImageAlt={titleImageAlt ?? title}
            />
            {
              content && (
                <p set:html={markdownify(content)} class="mb-8 mt-8" />
              )
            }
            {
              button && (
                <Button
                  label={button.label}
                  link={button.link}
                  newtab
                  hoverInvert
                  color=""
                />
              )
            }
          </div>
        </div>
      </div>
      {
        hasMarkdownBody && (
          <div class="row justify-center mt-8">
            <div class="lg:col-9">
              <MarkdownBody entry={entry} />
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
